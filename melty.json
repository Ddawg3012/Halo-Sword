{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [
    {
      "slug": "custom-half-sword",
      "role": "primary"
    },
    {
      "slug": "halo-mcc",
      "role": "companion"
    }
  ],
  "components": [
    {
      "id": "main",
      "fileName": "HaloSword-*.zip",
      "label": "Halo Sword (UE4SS + gauntlet mod + HaloBridge)",
      "kind": "main",
      "required": true
    }
  ],
  "requirements": [],
  "mappings": [
    {
      "component": "main",
      "from": "Win64/ue4ss/Mods/HaloSword/bridge/",
      "to": "{managed}/HaloSword/bridge"
    },
    {
      "component": "main",
      "from": "Win64/",
      "to": "{game}/HalfSwordUE5/Binaries/Win64"
    }
  ],
  "launch": {
    "kind": "game"
  },
  "test": {
    "minutes": 6
  },
  "notes": {
    "beforeInstall": "Needs Halo: The Master Chief Collection with Halo 3 installed: the Elite and Brute models and the announcer are read from it each time you press Play. Nothing from Halo is in the download.",
    "firstLaunch": "Choose Free Mode in Half Sword's main menu (any map; 1 opponent is best) and start the fight: the Covenant gauntlet runs there. Progression stays plain Half Sword."
  },
  "together": [
    {
      "launch": {
        "kind": "exe",
        "path": "{managed}/HaloSword/bridge/dotnet.exe",
        "args": [
          "{managed}/HaloSword/bridge/app/HaloBridge.dll",
          "--halo",
          "{game:halo-mcc}"
        ],
        "cwd": "{managed}/HaloSword/bridge"
      },
      "startFirst": true,
      "hidden": true
    }
  ]
}
